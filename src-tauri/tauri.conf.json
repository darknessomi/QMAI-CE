{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "青幕AI写作 CE",
  "mainBinaryName": "qmai-ce",
  "version": "4.8.4",
  "identifier": "com.qingmuai.writer",
  "build": {
    "beforeDevCommand": "node scripts/gc-debug-artifacts.mjs && pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-migration-worker.mjs && pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": {
      "data": "$DATA/com.qingmuai.writer.ce",
      "localData": "$LOCALDATA/com.qingmuai.writer.ce",
      "config": "$CONFIG/com.qingmuai.writer.ce"
    },
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "青幕AI写作 CE",
        "width": 1200,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http:; img-src 'self' data: blob: https: asset: https://asset.localhost https://cdn.jsdelivr.net; media-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../skills/**/*": "skills/",
      "migration/runtime/": "migration/runtime/",
      "src/commands/sag/LICENSE": "licenses/SAG-Wiki-LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
