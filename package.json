    "@milkdown/kit": "^7.23.0",
    "@milkdown/react": "^7.23.0",
    "@milkdown/theme-nord": "^7.23.0",
    "@react-sigma/core": "^5.0.6",
    "@sentry/react": "^10.78.0",
    "@sigma/edge-curve": "^3.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-store": "^2.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "i18next": "^26.7.2",
    "js-yaml": "^4.3.2",
    "jsonrepair": "^3.15.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.73.0",
    "macos-traffic-lights": "^2.0.0",
    "mermaid": "^11.17.2",
    "opencc-js": "^1.4.2",
